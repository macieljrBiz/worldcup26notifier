<UserControl x:Class="WorldCupNotifier.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource GlassmorphismOverlayDark}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Summary Stats Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#13265A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
            Padding="18,12"
                Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <!-- Live -->
                <Border CornerRadius="8" Padding="12,6" Margin="0,0,12,0" BorderBrush="#38E4A5" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{StaticResource ChipLiveImage}" Stretch="Fill" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LiveCountText" Text="0" FontWeight="Bold" Foreground="#A2FFD8" FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text=" LIVE" FontWeight="Bold" Foreground="#A2FFD8" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Upcoming -->
                <Border CornerRadius="8" Padding="12,6" Margin="0,0,12,0" BorderBrush="#00C2FF" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{StaticResource ChipUpcomingImage}" Stretch="Fill" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpcomingCountText" Text="0" FontWeight="Bold" Foreground="#B7EBFF" FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text=" UPCOMING" FontWeight="Bold" Foreground="#B7EBFF" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Finished -->
                <Border CornerRadius="8" Padding="12,6" BorderBrush="#7284B0" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{StaticResource ChipFinishedImage}" Stretch="Fill" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FinishedCountText" Text="0" FontWeight="Bold" Foreground="#D5DEFF" FontSize="{StaticResource FontSizeBody}"/>
                        <TextBlock Text=" FINISHED" FontWeight="Bold" Foreground="#D5DEFF" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Persistent message banner -->
        <Border x:Name="PersistentMessageBorder"
                Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource GoalEventGradient}"
                BorderBrush="{StaticResource StatusGoalBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PersistentMessageTitleText"
                           Text=""
                           FontSize="{StaticResource FontSizeBody}"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="PersistentMessageDetailText"
                           Text=""
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Left Panel: Controls -->
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,4,0">
                <Border Background="{StaticResource CardSurfaceTextureBrush}"
                    CornerRadius="20" 
                Padding="16,14" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Effect="{StaticResource ShadowEffectMedium}">
                <StackPanel>
                    <TextBlock Text="GAME CONTROL"
                               Foreground="#8FB7FF"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="Bold" />
                    <TextBlock Text="Live polling" 
                               FontSize="{StaticResource FontSizeHeader3}" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Keep this app running to monitor match changes. Native notifications are sent by Windows, not the browser."
                               Foreground="#BDD3FF"
                               TextWrapping="Wrap"
                               Margin="0,8,0,12"
                               LineHeight="22" />

                    <Border CornerRadius="12" Padding="10" Margin="0,0,0,10" BorderBrush="#274582" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{StaticResource CardSurfaceTextureImage}" Stretch="UniformToFill" Opacity="0.85" />
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="CONTROL TIP" Foreground="#7DA9FF" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" />
                            <TextBlock Text="Use Check for immediate sync. Start keeps background polling active with tray support."
                                       Foreground="#D1DEFF"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <WrapPanel>
                        <Button x:Name="CheckNowButton" 
                            Content="Check Now" 
                                Click="CheckNowButton_Click" 
                            Style="{StaticResource ImagePrimaryButton}"
                                Padding="14,8" 
                                Margin="0,0,8,8"
                                Cursor="Hand">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Button.RenderTransform>
                        </Button>
                        <Button x:Name="StartStopButton" 
                            Content="Start" 
                                Click="StartStopButton_Click" 
                                Style="{StaticResource ImagePrimaryButton}"
                                Padding="14,8" 
                                Margin="0,0,8,8"
                                Cursor="Hand">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Button.RenderTransform>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right Panel: Feed -->
        <Border Grid.Row="2" Grid.Column="1" 
            Background="{StaticResource CardSurfaceTextureBrush}" 
                CornerRadius="20" 
                Padding="{StaticResource MarginContainerPadding}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
            Margin="6,12,0,0"
                Effect="{StaticResource ShadowEffectMedium}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Battle Feed" 
                                   FontSize="{StaticResource FontSizeHeader3}" 
                                   FontWeight="Bold" 
                               Foreground="White" />
                        <TextBlock x:Name="FeedSummaryTextBlock" 
                                   Text="No alerts yet." 
                                   Foreground="{StaticResource SecondaryTextBrush}" 
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" 
                            Content="Clear" 
                            Click="ClearFeedButton_Click" 
                            Style="{StaticResource ImagePrimaryButton}"
                            Padding="14,8" 
                            HorizontalAlignment="Right"
                            Cursor="Hand">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Button.RenderTransform>
                    </Button>
                </DockPanel>
                <ListBox x:Name="FeedListBox" 
                         Grid.Row="1" 
                         Margin="0,14,0,0" 
                         BorderBrush="{StaticResource BorderBrush}" 
                         VerticalAlignment="Stretch" 
                         VerticalContentAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" 
                                    Margin="6" 
                                    BorderBrush="{Binding EventType, Converter={StaticResource EventTypeConverter}}" 
                                    BorderThickness="2" 
                                    CornerRadius="14" 
                                    Background="{Binding EventType, Converter={StaticResource EventTypeBackgroundConverter}}"
                                    Effect="{StaticResource ShadowEffectSubtle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Event Icon -->
                                     <Image Grid.Column="0"
                                         Width="24"
                                         Height="24"
                                         VerticalAlignment="Top"
                                         Margin="0,0,12,0"
                                         Source="{Binding EventType, Converter={StaticResource EventTypeIconImageConverter}}" />

                                    <!-- Main Content -->
                                    <StackPanel Grid.Column="1">
                                        <!-- Event Title -->
                                        <TextBlock Text="{Binding Title}" 
                                                   FontWeight="Bold" 
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="White" 
                                                   TextWrapping="Wrap" />
                                        
                                        <!-- Match Info (if available) -->
                                        <TextBlock Text="{Binding MatchDisplay}" 
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E4EEFF" 
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding MatchDisplay, Converter={StaticResource NullToVisibilityConverter}}" />
                                        
                                        <!-- Score Display (if available) -->
                                        <TextBlock Text="{Binding ScoreDisplay}" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrandBrush}" 
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding ScoreDisplay, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Message -->
                                        <TextBlock Text="{Binding Message}" 
                                                   Foreground="#C5D8FF" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,6,0,0"
                                                   LineHeight="21" />

                                        <!-- Match Progress Bar (if match in progress) -->
                                        <ProgressBar Value="{Binding MatchProgressPercentage, Mode=OneWay}"
                                                     Height="4"
                                                     Margin="0,8,0,0"
                                                     Background="{StaticResource BorderBrush}"
                                                     Foreground="{StaticResource PrimaryBrandBrush}"
                                                     Visibility="{Binding MatchStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Right"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="{Binding CreatedAtDisplay}" 
                                                   Foreground="#9BB2DF" 
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
