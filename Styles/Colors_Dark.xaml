<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme Color Palette -->

    <!-- Primary Branding -->
    <Color x:Key="PrimaryBrandColor">#0052CC</Color>
    <SolidColorBrush x:Key="PrimaryBrandBrush" Color="{StaticResource PrimaryBrandColor}" />

    <!-- Accents (vibrant, same as light) -->
    <Color x:Key="AccentGoldColor">#FFD700</Color>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}" />

    <!-- Status Colors (same as light) -->
    <Color x:Key="StatusLiveColor">#EF4444</Color>
    <SolidColorBrush x:Key="StatusLiveBrush" Color="{StaticResource StatusLiveColor}" />

    <Color x:Key="StatusGoalColor">#FFD700</Color>
    <SolidColorBrush x:Key="StatusGoalBrush" Color="{StaticResource StatusGoalColor}" />

    <Color x:Key="StatusKickoffColor">#10B981</Color>
    <SolidColorBrush x:Key="StatusKickoffBrush" Color="{StaticResource StatusKickoffColor}" />

    <Color x:Key="StatusFinalColor">#0052CC</Color>
    <SolidColorBrush x:Key="StatusFinalBrush" Color="{StaticResource StatusFinalColor}" />

    <Color x:Key="StatusIdleColor">#6B7280</Color>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="{StaticResource StatusIdleColor}" />

    <Color x:Key="StatusErrorColor">#F59E0B</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />

    <!-- Text Colors (inverted for dark) -->
    <Color x:Key="PrimaryTextColor">#E0E0E0</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />

    <Color x:Key="SecondaryTextColor">#B0B8C8</Color>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />

    <Color x:Key="HintTextColor">#7A8596</Color>
    <SolidColorBrush x:Key="HintTextBrush" Color="{StaticResource HintTextColor}" />

    <!-- Background Colors (dark) -->
    <Color x:Key="WindowBackgroundColor">#1e1e2e</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />

    <Color x:Key="CardBackgroundColor">#2a2a3e</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />

    <Color x:Key="CardBackgroundGlassColor">#2a2a3e</Color>
    <SolidColorBrush x:Key="CardBackgroundGlassBrush" Color="{StaticResource CardBackgroundGlassColor}" Opacity="0.95" />

    <Color x:Key="StatusBoxBackgroundColor">#323648</Color>
    <SolidColorBrush x:Key="StatusBoxBackgroundBrush" Color="{StaticResource StatusBoxBackgroundColor}" />

    <Color x:Key="FeedItemBackgroundColor">#2d2d40</Color>
    <SolidColorBrush x:Key="FeedItemBackgroundBrush" Color="{StaticResource FeedItemBackgroundColor}" />

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#4A5568</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <Color x:Key="BorderHighlightColor">#FFD700</Color>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="{StaticResource BorderHighlightColor}" />

    <!-- Shadow Colors -->
    <Color x:Key="ShadowColor">#000000</Color>

</ResourceDictionary>
