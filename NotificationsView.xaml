<UserControl x:Class="WorldCupNotifier.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource GlassmorphismOverlayDark}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#13265A"
                BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
                Padding="18">
            <StackPanel>
                <TextBlock Text="Notifications"
                           FontSize="{StaticResource FontSizeHeader2}"
                           FontWeight="Bold"
                   Foreground="White" />
                <TextBlock Text="Alert history from all World Cup matches"
                           FontSize="{StaticResource FontSizeLabel}"
                   Foreground="#BDD3FF"
                       Margin="0,4,0,10" />

                <Border x:Name="PersistentMessageBorder"
                        Background="#2E2A11"
                        BorderBrush="#FFBE3B"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="PersistentMessageTitleText"
                                   FontWeight="Bold"
                                   Foreground="#FFE6A7" />
                        <TextBlock x:Name="PersistentMessageDetailText"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#FFEFD0" />
                    </StackPanel>
                </Border>

                <!-- Filter Buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="FilterAllButton" Content="All"
                            Tag="All"
                            Style="{StaticResource ImagePrimaryButton}"
                            Padding="14,6" Margin="0,0,8,0"
                            FontSize="{StaticResource FontSizeLabel}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="FilterButton_Click">
                        <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                    </Button>
                        <Button x:Name="FilterGoalButton" Content="Goals"
                            Tag="Goal"
                            Style="{StaticResource ImagePrimaryButton}"
                            Padding="14,6" Margin="0,0,8,0"
                            FontSize="{StaticResource FontSizeLabel}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="FilterButton_Click">
                        <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                    </Button>
                        <Button x:Name="FilterKickoffButton" Content="Kickoff"
                            Tag="Kickoff"
                            Style="{StaticResource ImagePrimaryButton}"
                            Padding="14,6" Margin="0,0,8,0"
                            FontSize="{StaticResource FontSizeLabel}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="FilterButton_Click">
                        <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                    </Button>
                        <Button x:Name="FilterResultButton" Content="Results"
                            Tag="Result"
                            Style="{StaticResource ImagePrimaryButton}"
                            Padding="14,6"
                            FontSize="{StaticResource FontSizeLabel}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="FilterButton_Click">
                        <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Alerts List + Empty State -->
        <Grid Grid.Row="1">
            <!-- Empty state shown when list has no items -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=NotificationsListBox}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔔" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="No alerts yet"
                           FontSize="{StaticResource FontSizeHeader3}"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Go to Dashboard and click Check Now to start polling for match events."
                           FontSize="{StaticResource FontSizeLabel}"
                           Foreground="#BDD3FF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Notifications list -->
            <ListBox x:Name="NotificationsListBox"
                     Margin="18,14,18,18"
                     Background="Transparent"
                     BorderThickness="0"
                     BorderBrush="{StaticResource BorderBrush}"
                     VerticalAlignment="Stretch">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" 
                                Margin="4" 
                                BorderBrush="{Binding EventType, Converter={StaticResource EventTypeConverter}}" 
                                BorderThickness="2" 
                                CornerRadius="14" 
                                Background="{Binding EventType, Converter={StaticResource EventTypeBackgroundConverter}}"
                                Effect="{StaticResource ShadowEffectSubtle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        VerticalAlignment="Top"
                                        Margin="0,0,12,0"
                                        Source="{Binding EventType, Converter={StaticResource EventTypeIconImageConverter}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" 
                                               FontWeight="Bold" 
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="White" 
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MatchDisplay}" 
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="#E6F2FF" 
                                               Margin="0,6,0,0"
                                               Visibility="{Binding MatchDisplay, Converter={StaticResource NullToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Message}" 
                                               Foreground="#C4D7FF" 
                                               TextWrapping="Wrap" 
                                               Margin="0,6,0,0"
                                               LineHeight="21" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Right"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{Binding CreatedAtDisplay}" 
                                               Foreground="{StaticResource HintTextBrush}" 
                                               FontSize="{StaticResource FontSizeCaption}"
                                               TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
