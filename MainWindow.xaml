<Window x:Class="WorldCupNotifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Cup Notifier"
        Height="760"
        Width="1120"
        MinHeight="680"
        MinWidth="980"
        Background="#F4F7FB">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="16" Padding="24" BorderBrush="#D8E0EC" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Soccer World Cup" Foreground="#0067B8" FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="Native team notification tracker" FontSize="34" FontWeight="Bold" Foreground="#172033" Margin="0,4,0,0" />
                    <TextBlock Text="Track football-data.org match updates and get Windows native notifications for kickoff, goals, and final results."
                               Foreground="#61708A"
                               FontSize="16"
                               TextWrapping="Wrap"
                               MaxWidth="720"
                               Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F7FAFF" BorderBrush="#D8E0EC" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Status" Foreground="#61708A" FontWeight="Bold" />
                            <TextBlock x:Name="StatusTextBlock" Text="Idle" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                            <TextBlock x:Name="LastCheckedTextBlock" Text="Live data not checked yet." Foreground="#61708A" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Grid.Column="1" Content="⚙" Click="SettingsButton_Click" Width="48" Height="48" Margin="12,0,0,0" FontSize="20" Background="White" BorderBrush="#D8E0EC" Foreground="#61708A" />
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Background="White" CornerRadius="16" Padding="20" BorderBrush="#D8E0EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Live polling" FontSize="22" FontWeight="Bold" Foreground="#172033" />
                        <TextBlock Text="Keep this app running to monitor match changes. Native notifications are sent by Windows, not the browser."
                                   Foreground="#61708A"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12" />
                        <WrapPanel>
                            <Button x:Name="CheckNowButton" Content="Check live data now" Click="CheckNowButton_Click" Padding="14,8" Margin="0,0,8,8" />
                            <Button x:Name="StartStopButton" Content="Start polling" Click="StartStopButton_Click" Padding="14,8" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" BorderBrush="#D8E0EC" BorderThickness="1" Margin="18,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Notification feed" FontSize="22" FontWeight="Bold" Foreground="#172033" />
                            <TextBlock x:Name="FeedSummaryTextBlock" Text="No alerts yet." Foreground="#61708A" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Clear feed" Click="ClearFeedButton_Click" Padding="14,8" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ListBox x:Name="FeedListBox" Grid.Row="1" Margin="0,16,0,0" BorderBrush="#D8E0EC">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="4" BorderBrush="#D8E0EC" BorderThickness="1" CornerRadius="10" Background="#F9FBFF">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#172033" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Message}" Foreground="#172033" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding CreatedAtDisplay}" Foreground="#61708A" FontSize="12" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
