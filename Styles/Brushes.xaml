<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gradient and Effect Resources -->

    <!-- Header Gradient (Gold to Blue) -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFD700" Offset="0" />
        <GradientStop Color="#0052CC" Offset="1" />
    </LinearGradientBrush>

    <!-- Match Card Gradient Template (dynamic in code-behind) -->
    <LinearGradientBrush x:Key="MatchCardGradientDefault" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFD70080" Offset="0" />
        <GradientStop Color="#0052CC80" Offset="1" />
    </LinearGradientBrush>

    <!-- Event-Based Gradient Brushes -->
    <LinearGradientBrush x:Key="KickoffEventGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B98110" Offset="0" />
        <GradientStop Color="#10B98105" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoalEventGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD70015" Offset="0" />
        <GradientStop Color="#FFD70008" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ResultEventGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0052CC15" Offset="0" />
        <GradientStop Color="#0052CC08" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InfoEventGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9CA3AF10" Offset="0" />
        <GradientStop Color="#9CA3AF05" Offset="1" />
    </LinearGradientBrush>

    <!-- Glassmorphism Background Overlay (light) -->
    <LinearGradientBrush x:Key="GlassmorphismOverlayLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F9FBFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Glassmorphism Background Overlay (dark) -->
    <LinearGradientBrush x:Key="GlassmorphismOverlayDark" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2a2a3e" Offset="0" />
        <GradientStop Color="#1e1e2e" Offset="1" />
    </LinearGradientBrush>

    <!-- Shadow Effect -->
    <DropShadowEffect x:Key="ShadowEffectSubtle" 
                      BlurRadius="8" 
                      ShadowDepth="2" 
                      Opacity="0.1" 
                      Color="#000000" />

    <DropShadowEffect x:Key="ShadowEffectMedium" 
                      BlurRadius="12" 
                      ShadowDepth="4" 
                      Opacity="0.15" 
                      Color="#000000" />

    <DropShadowEffect x:Key="ShadowEffectStrong" 
                      BlurRadius="16" 
                      ShadowDepth="6" 
                      Opacity="0.2" 
                      Color="#000000" />

</ResourceDictionary>
