<Window x:Class="WorldCupNotifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Cup Notifier"
        Height="760"
        Width="1120"
        MinHeight="680"
        MinWidth="980"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="{StaticResource MarginWindowOuter}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Background="{StaticResource CardBackgroundBrush}" 
                CornerRadius="20" 
                Padding="{StaticResource MarginContainerPadding}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1"
                Effect="{StaticResource ShadowEffectMedium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Soccer World Cup" 
                               Foreground="{StaticResource PrimaryBrandBrush}" 
                               FontWeight="Bold" 
                               FontSize="{StaticResource FontSizeCaption}" />
                    <TextBlock Text="Native team notification tracker" 
                               FontSize="{StaticResource FontSizeHeader1}" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryTextBrush}" 
                               Margin="0,4,0,0" />
                    <TextBlock Text="Track football-data.org match updates and get Windows native notifications for kickoff, goals, and final results."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               MaxWidth="720"
                               Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource StatusBoxBackgroundBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="{StaticResource SpaceLarge}"
                            Effect="{StaticResource ShadowEffectSubtle}">
                        <StackPanel>
                            <TextBlock Text="Status" 
                                       Foreground="{StaticResource SecondaryTextBrush}" 
                                       FontWeight="Bold" />
                            <TextBlock x:Name="StatusTextBlock" 
                                       Text="Idle" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource StatusKickoffBrush}" 
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="LastCheckedTextBlock" 
                                       Text="Live data not checked yet." 
                                       Foreground="{StaticResource SecondaryTextBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" 
                            Grid.Column="1" 
                            Content="⚙" 
                            Click="SettingsButton_Click" 
                            Width="48" 
                            Height="48" 
                            Margin="12,0,0,0" 
                            FontSize="20" 
                            Background="{StaticResource CardBackgroundBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            Foreground="{StaticResource SecondaryTextBrush}" 
                            Cursor="Hand">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Button.RenderTransform>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Controls -->
            <StackPanel Grid.Column="0">
                <Border Background="{StaticResource CardBackgroundBrush}" 
                        CornerRadius="20" 
                        Padding="{StaticResource MarginContainerPadding}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1"
                        Effect="{StaticResource ShadowEffectMedium}">
                    <StackPanel>
                        <TextBlock Text="Live polling" 
                                   FontSize="{StaticResource FontSizeHeader3}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Keep this app running to monitor match changes. Native notifications are sent by Windows, not the browser."
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12" />
                        <WrapPanel>
                            <Button x:Name="CheckNowButton" 
                                    Content="🔄 Check" 
                                    Click="CheckNowButton_Click" 
                                    Padding="14,8" 
                                    Margin="0,0,8,8"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Cursor="Hand">
                                <Button.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Button.RenderTransform>
                            </Button>
                            <Button x:Name="StartStopButton" 
                                    Content="▶ Start" 
                                    Click="StartStopButton_Click" 
                                    Padding="14,8" 
                                    Margin="0,0,8,8"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Cursor="Hand">
                                <Button.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Button.RenderTransform>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Panel: Feed -->
            <Border Grid.Column="1" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    CornerRadius="20" 
                    Padding="{StaticResource MarginContainerPadding}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    Margin="18,0,0,0"
                    Effect="{StaticResource ShadowEffectMedium}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Notification feed" 
                                       FontSize="{StaticResource FontSizeHeader3}" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="FeedSummaryTextBlock" 
                                       Text="No alerts yet." 
                                       Foreground="{StaticResource SecondaryTextBrush}" 
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" 
                                Content="🗑 Clear" 
                                Click="ClearFeedButton_Click" 
                                Padding="14,8" 
                                HorizontalAlignment="Right"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Cursor="Hand">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Button.RenderTransform>
                        </Button>
                    </DockPanel>
                    <ListBox x:Name="FeedListBox" 
                             Grid.Row="1" 
                             Margin="0,16,0,0" 
                             BorderBrush="{StaticResource BorderBrush}" 
                             VerticalAlignment="Stretch" 
                             VerticalContentAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" 
                                        Margin="4" 
                                        BorderBrush="{Binding EventType, Converter={StaticResource EventTypeConverter}}" 
                                        BorderThickness="2" 
                                        CornerRadius="14" 
                                        Background="{Binding EventType, Converter={StaticResource EventTypeBackgroundConverter}}"
                                        Effect="{StaticResource ShadowEffectSubtle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Event Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding EventIcon}"
                                                   FontSize="24"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,12,0" />

                                        <!-- Main Content -->
                                        <StackPanel Grid.Column="1">
                                            <!-- Event Title -->
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Bold" 
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{StaticResource PrimaryTextBrush}" 
                                                       TextWrapping="Wrap" />
                                            
                                            <!-- Match Info (if available) -->
                                            <TextBlock Text="{Binding MatchDisplay}" 
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" 
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding MatchDisplay, Converter={StaticResource NullToVisibilityConverter}}" />
                                            
                                            <!-- Score Display (if available) -->
                                            <TextBlock Text="{Binding ScoreDisplay}" 
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrandBrush}" 
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding ScoreDisplay, Converter={StaticResource NullToVisibilityConverter}}" />

                                            <!-- Message -->
                                            <TextBlock Text="{Binding Message}" 
                                                       Foreground="{StaticResource SecondaryTextBrush}" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,6,0,0" />

                                            <!-- Match Progress Bar (if match in progress) -->
                                            <ProgressBar Value="{Binding MatchProgressPercentage, Mode=OneWay}"
                                                         Height="4"
                                                         Margin="0,8,0,0"
                                                         Background="{StaticResource BorderBrush}"
                                                         Foreground="{StaticResource PrimaryBrandBrush}"
                                                         Visibility="{Binding MatchStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </StackPanel>

                                        <!-- Timestamp -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Right"
                                                    Margin="12,0,0,0">
                                            <TextBlock Text="{Binding CreatedAtDisplay}" 
                                                       Foreground="{StaticResource HintTextBrush}" 
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
