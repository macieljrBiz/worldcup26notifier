<UserControl x:Class="WorldCupNotifier.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource GlassmorphismOverlayDark}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <!-- Title -->
            <TextBlock Text="Settings" 
                       FontSize="{StaticResource FontSizeHeader2}" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       Margin="0,0,0,20"/>

            <!-- API Key Section -->
                <Border Background="#132452" 
                    CornerRadius="16" 
                    Padding="16" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Effect="{StaticResource ShadowEffectSubtle}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="API Configuration" 
                               FontWeight="Bold" 
                                                             Foreground="White" />
                    <TextBlock Text="API Key (football-data.org)" 
                                                             Foreground="#BDD3FF"
                               Margin="0,12,0,4" />
                    <TextBox x:Name="ApiKeyInput"
                             Padding="10"
                             Height="36"
                                                         Background="#0F1B3E"
                                                         BorderBrush="#2C427B"
                                                         Foreground="#F1F7FF" />
                </StackPanel>
            </Border>

            <!-- Notification Preferences -->
                <Border Background="#132452" 
                    CornerRadius="16" 
                    Padding="16" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Effect="{StaticResource ShadowEffectSubtle}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Notification Preferences" 
                               FontWeight="Bold" 
                               Foreground="White" />
                    <CheckBox x:Name="NotifyKickoffCheck" Content="Notify on kickoff" Margin="0,12,0,8" Foreground="#DCE9FF" />
                    <CheckBox x:Name="NotifyGoalsCheck" Content="Notify on goals" Margin="0,0,0,8" Foreground="#DCE9FF" />
                    <CheckBox x:Name="NotifyResultsCheck" Content="Notify on final result" Margin="0,0,0,8" Foreground="#DCE9FF" />
                    <CheckBox x:Name="EnableNotificationsCheck" Content="Enable native notifications" Margin="0,0,0,0" Foreground="#DCE9FF" />
                </StackPanel>
            </Border>

            <!-- Theme Settings -->
                <Border Background="#132452" 
                    CornerRadius="16" 
                    Padding="16" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Effect="{StaticResource ShadowEffectSubtle}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Theme" 
                               FontWeight="Bold" 
                               Foreground="White" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <RadioButton x:Name="LightThemeRadio" Content="Light" Foreground="#DCE9FF" Margin="0,0,20,0" />
                        <RadioButton x:Name="DarkThemeRadio" Content="Dark" Foreground="#DCE9FF" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button x:Name="SaveSettingsButton"
                    Content="💾 Save Settings"
                    Style="{StaticResource ImagePrimaryButton}"
                    Padding="16,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,0">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Button.RenderTransform>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
