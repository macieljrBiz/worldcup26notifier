<Window x:Class="WorldCupNotifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Cup Notifier"
        Height="760"
        Width="1120"
        MinHeight="680"
        MinWidth="980"
        Background="{StaticResource GlassmorphismOverlayDark}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.RowSpan="2" Grid.Column="0" RadiusX="24" RadiusY="24" Fill="#0E1B40" Opacity="0.95" />

        <!-- Header Card (spans both columns) -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="{StaticResource HeaderHeroBackgroundBrush}" 
                CornerRadius="20" 
                Padding="24,20" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1"
                Effect="{StaticResource ShadowEffectMedium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <Image Source="{StaticResource HeroOrbsOverlayImage}" Stretch="Fill" Opacity="0.52" IsHitTestVisible="False" Grid.ColumnSpan="2" />

                <StackPanel>
                    <TextBlock Text="SOCCER WORLD CUP" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               FontSize="{StaticResource FontSizeCaption}" 
                               Opacity="0.9" />
                    <TextBlock Text="Native team notification tracker" 
                               FontSize="{StaticResource FontSizeHeader1}" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,6,0,0" />
                    <TextBlock Text="Track football-data.org match updates and get Windows native notifications for kickoff, goals, and final results."
                               Foreground="#DDE8FF"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               MaxWidth="700"
                               Margin="0,12,0,0"
                               LineHeight="29" />
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource StatusBoxBackgroundBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="{StaticResource SpaceLarge}"
                            Margin="0,0,4,0"
                            Effect="{StaticResource ShadowEffectSubtle}">
                        <StackPanel>
                            <TextBlock Text="Status" 
                                       Foreground="#D8E6FF" 
                                       FontWeight="Bold" />
                            <TextBlock x:Name="StatusTextBlock" 
                                       Text="Idle" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource StatusKickoffBrush}" 
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="LastCheckedTextBlock" 
                                       Text="Live data not checked yet." 
                                       Foreground="#D4E4FF" 
                                       TextWrapping="Wrap" 
                                       Margin="0,10,0,0"
                                       LineHeight="22" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" 
                            Grid.Column="1" 
                            Click="SettingsButton_Click" 
                            Width="48" 
                            Height="48" 
                            Margin="12,0,0,0" 
                            Background="#22356B" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            Foreground="#DCE8FF" 
                            Cursor="Hand">
                        <Image Source="{StaticResource NavIconSettingsImage}" Width="20" Height="20" Stretch="Uniform" />
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Button.RenderTransform>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Sidebar Navigation (Grid.Row="1" Grid.Column="0") -->
        <Border Grid.Row="1" Grid.Column="0" 
            Background="{StaticResource ShellPanelTextureBrush}" 
                CornerRadius="20" 
                Padding="14" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1"
                Effect="{StaticResource ShadowEffectMedium}"
                Margin="0,16,12,0">
            <StackPanel>
                <Border Background="#0B1840" CornerRadius="14" Padding="14" Margin="0,0,0,14" BorderBrush="#29498F" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="WORLD CUP HQ" FontWeight="Bold" Foreground="White" FontSize="14" />
                        <TextBlock Text="Game-ready alerts and live tracking" Margin="0,4,0,0" Foreground="#BFD3FF" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Button x:Name="DashboardNavButton" 
                        Click="NavButton_Click" 
                        Tag="Dashboard"
                        Padding="12,12" 
                        Margin="0,0,0,8"
                        Background="{StaticResource PrimaryBrandBrush}"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource NavIconDashboardImage}" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Dashboard" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                </Button>
                <Button x:Name="NotificationsNavButton" 
                        
                        Click="NavButton_Click" 
                        Tag="Notifications"
                        Padding="12,12" 
                        Margin="0,0,0,8"
                        Background="{StaticResource BorderBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource NavIconNotificationsImage}" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Notifications" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                </Button>
                <Button x:Name="MatchesNavButton" 
                        
                        Click="NavButton_Click" 
                        Tag="Matches"
                        Padding="12,12" 
                        Margin="0,0,0,8"
                        Background="{StaticResource BorderBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource NavIconMatchesImage}" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Matches" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                </Button>
                <Button x:Name="SettingsNavButton" 
                        
                        Click="NavButton_Click" 
                        Tag="Settings"
                        Padding="12,12" 
                        Margin="0,0,0,8"
                        Background="{StaticResource BorderBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource NavIconSettingsImage}" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                </Button>
                <Button x:Name="AboutNavButton" 
                        
                        Click="NavButton_Click" 
                        Tag="About"
                        Padding="12,12" 
                        Margin="0,0,0,0"
                        Background="{StaticResource BorderBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource NavIconAboutImage}" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="About" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content Area (Grid.Row="1" Grid.Column="1") -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,18,0,0">
            <!-- Content Container for switching views -->
            <Border x:Name="ContentBorder" 
                    Background="#101B3B" 
                    CornerRadius="20" 
                    Padding="{StaticResource MarginContainerPadding}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Effect="{StaticResource ShadowEffectMedium}">
                <ContentControl x:Name="ContentControl" Content="{x:Null}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
