<Window x:Class="WorldCupNotifier.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="700"
        Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Configuration" FontSize="24" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,20" />

            <TextBlock Text="football-data.org API key" Foreground="#61708A" FontWeight="SemiBold" Margin="0,0,0,6" />
            <PasswordBox x:Name="ApiKeyPasswordBox" Height="36" Margin="0,0,0,14" />

            <TextBlock Text="Competition code" Foreground="#61708A" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="CompetitionTextBox" Height="36" Margin="0,0,0,14" />

            <TextBlock Text="Favorite team" Foreground="#61708A" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="TeamComboBox" Height="36" IsEditable="True" Margin="0,0,0,14" />

            <TextBlock Text="Alert types" Foreground="#61708A" FontWeight="SemiBold" Margin="0,18,0,8" />
            <CheckBox x:Name="KickoffCheckBox" Content="Game about to start / match live" IsChecked="True" Margin="0,0,0,8" />
            <CheckBox x:Name="GoalsCheckBox" Content="Goals / score changes" IsChecked="True" Margin="0,0,0,8" />
            <CheckBox x:Name="ResultsCheckBox" Content="Final results" IsChecked="True" Margin="0,0,0,8" />
            <CheckBox x:Name="BreakingNewsCheckBox" IsEnabled="False">
                <TextBlock Text="Breaking news / injuries (not supported by football-data.org)" TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock Text="Polling interval, seconds" Foreground="#61708A" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBox x:Name="PollingIntervalTextBox" Height="36" Margin="0,0,0,6" />
            <TextBlock Text="Minimum is 70 seconds to stay below your 10 calls/minute limit." Foreground="#61708A" TextWrapping="Wrap" Margin="0,0,0,14" />

            <CheckBox x:Name="NotificationsEnabledCheckBox" Content="Enable native Windows notifications" IsChecked="True" Margin="0,18,0,20" />

            <WrapPanel>
                <Button x:Name="TestNotificationButton" Content="Send test notification" Click="TestNotificationButton_Click" Padding="14,8" Margin="0,0,8,8" />
                <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" Padding="14,8" Margin="0,0,8,8" IsDefault="True" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
