<UserControl x:Class="WorldCupNotifier.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource GlassmorphismOverlayDark}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#13265A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Match Schedule" 
                           FontSize="{StaticResource FontSizeHeader2}" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="Live World Cup matches" 
                           FontSize="{StaticResource FontSizeLabel}"
                           Foreground="#BDD3FF"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Matches List -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Empty state shown when no matches loaded -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="20,60,20,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=MatchesItemsControl}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="⚽" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="No matches loaded"
                               FontSize="{StaticResource FontSizeHeader3}"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Go to Dashboard and click Check Now to fetch the current match schedule."
                               FontSize="{StaticResource FontSizeLabel}"
                               Foreground="#BDD3FF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="300"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Match cards -->
                <StackPanel Margin="20,16,20,20">
                    <ItemsControl x:Name="MatchesItemsControl"
                                  MouseLeftButtonUp="MatchesItemsControl_MouseLeftButtonUp">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12"
                                    BorderThickness="1"
                                    Padding="16"
                                    Margin="0,0,0,12"
                                    Effect="{StaticResource ShadowEffectSubtle}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#132452"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="IN_PLAY">
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusKickoffBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="PAUSED">
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusKickoffBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Date/Time -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Foreground="#90A8D8"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Margin="0,0,0,8">
                                        <TextBlock.Text>
                                            <Binding Path="UtcDate" StringFormat="ddd MMM dd · HH:mm UTC"/>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- Chevron -->
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Foreground="#90A8D8"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▼"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="▲"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Match Info (Teams) -->
                                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Home Team -->
                                        <TextBlock Grid.Column="0"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextAlignment="Right"
                                                   Margin="0,0,12,0">
                                            <TextBlock.Text>
                                                <Binding Path="HomeTeam.Name"/>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <!-- VS -->
                                        <TextBlock Grid.Column="1"
                                                   Text="vs"
                                                   Foreground="#9FB6E6"
                                                   Margin="8,0,8,0"
                                                   FontSize="{StaticResource FontSizeCaption}"/>

                                        <!-- Away Team -->
                                        <TextBlock Grid.Column="2"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextAlignment="Left"
                                                   Margin="12,0,0,0">
                                            <TextBlock.Text>
                                                <Binding Path="AwayTeam.Name"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Status Badge with pulse for live matches -->
                                    <Border Grid.Row="1" Grid.Column="1"
                                            CornerRadius="4"
                                            Padding="8,4,8,4"
                                            Margin="20,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding Status, Converter={StaticResource MatchStatusColorConverter}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="IN_PLAY">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1" To="0.45"
                                                                                     Duration="0:0:0.7"
                                                                                     AutoReverse="True"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="White"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Score -->
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="{Binding Score, Converter={StaticResource MatchScoreConverter}}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="20,0,0,0"
                                               FontSize="{StaticResource FontSizeHeader3}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentGoldBrush}"/>

                                    <!-- Expanded Details (Row 2) -->
                                    <Border Grid.Row="2" Grid.ColumnSpan="3"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,12,0,0"
                                            Padding="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- HalfTime Score -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="HALF-TIME"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="#90A8D8"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Score.HalfTime, Converter={StaticResource MatchScoreConverter}}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="Bold"
                                                           Foreground="#C8D9FF"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Full-Time Score -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="FULL-TIME"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="#90A8D8"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Score.FullTime, Converter={StaticResource MatchScoreConverter}}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentGoldBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Match ID -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="MATCH ID"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="#90A8D8"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Id}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="Bold"
                                                           Foreground="#C8D9FF"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
